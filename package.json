{
  "name": "j-platpat-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the official JPO patent information acquisition API.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "yamayued",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "j-platpat-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yamayued/j-platpat-mcp.git"
  },
  "homepage": "https://github.com/yamayued/j-platpat-mcp",
  "bugs": {
    "url": "https://github.com/yamayued/j-platpat-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jpo",
    "j-platpat",
    "patent",
    "trademark",
    "japan"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:api-parity": "node scripts/check-api-parity.mjs",
    "check:api-parity:remote": "node scripts/check-api-parity.mjs --check-remote",
    "check:api-parity:remote:issue": "node scripts/check-api-parity.mjs --check-remote --create-issue",
    "dev": "node --enable-source-maps --import tsx src/index.ts",
    "dev:local": "node --enable-source-maps --import tsx src/index.ts",
    "test:no-credentials": "npm run build && node --enable-source-maps scripts/missing-credentials-smoke-test.mjs",
    "test:mcp": "npm run build && node --enable-source-maps scripts/mcp-tool-smoke-test.mjs",
    "test:mock": "npm run build && node --enable-source-maps scripts/mock-smoke-test.mjs",
    "check:coverage": "npm run check:api-parity",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node --enable-source-maps dist/index.js",
    "start:local": "node --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
